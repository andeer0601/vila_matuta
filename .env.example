# Public demo: set true at BUILD and RUNTIME, keep all service credentials empty.
# Real deployment: set false and complete the production security checklist.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
INFINITEPAY_HANDLE=
APP_URL=
# Enable only after applying migrations, configuring the account and validating the payment flow.
PAYMENTS_ENABLED=false

# Server-only encryption keyring: JSON mapping key IDs to independent 32-byte base64 keys.
# Generate locally; never commit real keys. Keep previous keys during rotation.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY=v1
# Independent random secret, at least 32 characters. HMAC for rate-limit bucket identities.
RATE_LIMIT_SECRET=
# none locally; netlify or vercel only when hosted behind that platform.
TRUSTED_PROXY=none
# Public Turnstile site key. Configure its SECRET in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
